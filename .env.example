# --- Supabase ---
# Project Settings > API in the Supabase dashboard.
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never import this outside
# one-off scripts (e.g. content sync). Never used in a request path.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle) ---
# Pooled connection (Supabase "Transaction" pooler, port 6543). Used at runtime.
DATABASE_URL=

# Used only by drizzle-kit for migrations. Supabase's raw "direct connection"
# (db.<ref>.supabase.co:5432) is IPv6-only and will silently hang on many
# home networks. Use "session mode" instead — same pooler host as
# DATABASE_URL above, but port 5432 instead of 6543:
#   postgresql://postgres.<ref>:[password]@<pooler-host>:5432/postgres
DIRECT_URL=

# --- AI Tutor ---
# Server-only. Never expose to the client.
# Optional — everything except the /tutor page works fine without this.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
